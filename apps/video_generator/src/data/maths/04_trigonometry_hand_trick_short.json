      "content": {
        "heading": "The 3 Golden Formulas",
        "bullets": [
          "Sin theta = sqrt(Fingers on Thumb Side) / 2",
          "Cos theta = sqrt(Fingers on Pinky Side) / 2",
          "Tan theta = sqrt(Thumb Side / Pinky Side)"
        ],
        "imageUrl": "images/trig_hand_base.jpg"
      },
